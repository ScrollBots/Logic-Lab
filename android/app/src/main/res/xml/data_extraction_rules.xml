<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for Android 12+ (cloud backup and device transfer).
  Only the local database and shared preferences are eligible.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
